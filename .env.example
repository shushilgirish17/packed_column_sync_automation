# Copy this file to `.env` and adjust as needed.
# Precedence: real environment variable > .env > built-in default.
# Consumed by lib/config.py (Python) and lib/env.ps1 (PowerShell).

# WinAppDriver endpoint (must be running for any click/UI automation).
WINAPPDRIVER_URL=http://127.0.0.1:4723

# UNICORN client process name (no .exe).
UNICORN_PROCESS=UNICORNClient

# Title of the Column Handling dialog to attach to.
COLUMN_DIALOG_TITLE=Column Handling

# Default access scope for generated import files:
#   Personal = visible only to the creating account (use for testing)
#   Global   = visible to everyone (production)
IMPORT_ACCESS_SCOPE=Personal

# Where exports / generated import files are written.
# Leave blank to use <project root>/exports.
EXPORTS_DIR=

# Local "queue" the agent watches. benchling_pull.py drops jobs into
# <WATCH_DIR>/incoming; watch_service.ps1 consumes them.
# Leave blank to use <project root>/watch.
WATCH_DIR=

# Benchling (only needed by benchling_pull.py in real mode; --mock ignores these)
BENCHLING_URL=
BENCHLING_API_KEY=
BENCHLING_ENTITY_SCHEMA=Packed Column

# UNICORN launch/login (used by ensure_unicorn.ps1 only when UNICORN is not
# already running). UNICORN_PASSWORD is a secret — it is read on demand and
# never printed or logged. UNICORN_EXE is optional; if blank, the script
# launches UNICORN via Start-menu search.
UNICORN_USER=
UNICORN_PASSWORD=
UNICORN_EXE=
UNICORN_MODULE=Evaluation

# In Lambda, credentials come from the SSM parameter named in BENCHLING_SSM_PARAMETER.
# Copy to .env for local runs (python -m tools.run_local / tools.inspect_schemas). Never commit .env.
BENCHLING_URL=https://<tenant>.benchling.com
BENCHLING_CLIENT_ID=
BENCHLING_CLIENT_SECRET=

# Fill after running: python -m tools.inspect_schemas "Packed Column" "Resin Characteristics"
PACKED_COLUMN_SCHEMA_ID=
RESIN_LIBRARY_SCHEMA_ID=
# COLUMN_PACKING_SCHEMA_ID=          # leave unset in Zifo
